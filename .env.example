# Copy this file to .env (docker compose loads it automatically) to enable
# conversational analytics / the Composer / the sandbox coding agent — all
# off by default. See README.md's "Conversational analytics" section for
# exactly what this sends to the provider once set.

# Anthropic API key ("sk-ant-..."). Either this or CI_LLM_BASE_URL below
# turns the LLM features on.
CI_LLM_API_KEY=

# Optional: default model a new conversation starts with.
# CI_LLM_MODEL=claude-sonnet-5

# Optional: talk to any server exposing an Anthropic-compatible /v1/messages
# endpoint instead of api.anthropic.com — LM Studio 0.4.1+, a litellm proxy.
# This is how you run an open-weights model locally so nothing leaves the
# machine; no API key is needed in that case. See the README's "Local and
# self-hosted models" section, including the tool_choice caveat.
# CI_LLM_BASE_URL=http://localhost:1234
# CI_LLM_MODEL=meta-models/Muse-Glimmer-30B

# Optional: replace the per-conversation model picker's options (comma-
# separated). The built-in claude id's are meaningless against a local
# endpoint, where the valid id's are whatever it has loaded.
# CI_LLM_MODEL_CHOICES=meta-models/Muse-Glimmer-30B
