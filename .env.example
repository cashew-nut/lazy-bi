# Copy this file to .env (docker compose loads it automatically) to enable
# conversational analytics / the Composer / the sandbox coding agent — all
# off by default. See README.md's "Conversational analytics" section for
# exactly what this sends to the provider once set.

# Anthropic API key ("sk-ant-..."). Required to turn the LLM features on.
CI_LLM_API_KEY=

# Optional: default model a new conversation starts with.
# CI_LLM_MODEL=claude-sonnet-5
